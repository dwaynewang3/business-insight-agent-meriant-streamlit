# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Secrets: never commit real keys
.env

# Run logs. The demo data (data/*.duckdb) is committed in this copy, already built, so a
# host doesn't have to build it.
data/*.duckdb.wal
logs/

# Local tool settings
.claude/settings.local.json

# OS and editors
.DS_Store
.vscode/
.idea/

# Generated answer keys (rebuilt with make data)
data/*_manifest.json

# Local notes, never committed
private/
