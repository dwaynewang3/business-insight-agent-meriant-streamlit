# Copy this file to .env and fill in your own keys.
# .env is git-ignored, so your keys are never committed.

# Anthropic API key, from the Claude Console
ANTHROPIC_API_KEY=

# Langfuse keys, from your project's Settings > API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Your Langfuse region:
#   EU     https://cloud.langfuse.com
#   US     https://us.cloud.langfuse.com
#   Japan  https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL=

# Optional: also open each approved ticket or alert as a GitHub issue (it stands in for Jira
# or ServiceNow). Leave empty to store them only in logs/actions.jsonl.
# Use a private repository, as owner/name, and a fine-grained token with "Issues: read and
# write" on that repository only.
ACTIONS_GITHUB_REPO=
ACTIONS_GITHUB_TOKEN=
