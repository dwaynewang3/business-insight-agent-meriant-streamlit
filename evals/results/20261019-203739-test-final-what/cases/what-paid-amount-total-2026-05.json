      {
        "claim": "May 2026 payments are $4,485,464 after excluding the duplicated reload batch. The raw total is $5,214,647, which includes $729,183 of duplicates.",
        "evidence_sql": "SELECT sum(amount) AS raw_paid, sum(amount) FILTER (WHERE load_batch NOT LIKE 'reload-%') AS paid_excl_reload, sum(amount) FILTER (WHERE load_batch LIKE 'reload-%') AS reload_amount FROM claim_payments WHERE payment_date BETWEEN '2026-05-01' AND '2026-05-31'",
